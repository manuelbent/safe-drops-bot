{
  "name": "safe-drops-bot",
  "version": "1.0.0",
  "description": "Turn the SNKRS shock drops into safe ones. Get notified.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test",
    "start": "node --env-file=.env dist/src/index.js",
    "migrate:up": "npx sequelize-cli db:migrate --config database/config.json --migrations-path database/migrations",
    "migrate:down": "npx sequelize-cli db:migrate:undo --config database/config.json --migrations-path database/migrations"
  },
  "author": "manuelbent",
  "license": "ISC",
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@types/pino": "^7.0.4",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.7",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "qs": "^6.17.1",
    "uuid": "^11.1.1",
    "request-promise-core": {
      "request": "npm:@cypress/request@^3.0.10"
    }
  }
}
