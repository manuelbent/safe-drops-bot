{
  "name": "safe-drops-bot",
  "version": "1.0.0",
  "description": "Turn the SNKRS shock drops into safe ones. Get notified.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env ./dist/index.js",
    "migrate:up": "npx sequelize-cli db:migrate --config src/database/config.json --migrations-path src/database/migrations",
    "migrate:down": "npx sequelize-cli db:migrate:undo --config src/database/config.json --migrations-path src/database/migrations"
  },
  "author": "manuelbent",
  "license": "ISC",
  "dependencies": {
    "@types/pino": "^7.0.4",
    "axios": "^1.7.7",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/node-telegram-bot-api": "^0.64.7",
    "typescript": "^5.6.2"
  }
}
